# ==============================================================================
# Friday AI Assistant — Environment Configuration Template
# Copy this file to .env and populate with your own API keys and settings.
# DO NOT commit real API keys or secrets to version control.
# ==============================================================================

# Operating Mode & LLM Providers
FRIDAY_MODE=auto
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=15
OLLAMA_STRICT_OFFLINE=false
OLLAMA_STREAM=true
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=5m
ALLOW_CLOUD_FALLBACK=false
GROQ_API=
GEMINI_API=
DEEPSEEK_API=

# Memory & Database (Supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Integrations & Plugins
GITHUB_TOKEN=

# Messaging & Reminders (Telegram)
BOT=
CHAT_ID=

# Speech Recognition (STT)
STT_ENABLED=false
STT_ENGINE=whisper
STT_MODEL_PATH=
STT_BINARY_PATH=
STT_LANGUAGE=auto
STT_TIMEOUT=30

# Wake-Word Detection
WAKE_WORD_ENABLED=false
WAKE_WORD_ENGINE=auto
WAKE_WORD_PHRASE=Hey Friday
WAKE_WORD_MODEL_PATH=
WAKE_WORD_SENSITIVITY=0.5
WAKE_WORD_COOLDOWN=2.0
WAKE_WORD_CHIME=false

# Continuous Listening & Interruption Handling
CONTINUOUS_LISTENING_ENABLED=false
VAD_ENGINE=auto
VAD_SENSITIVITY=0.5
SPEECH_END_SILENCE_MS=800
MIN_SPEECH_DURATION_MS=250
MAX_RECORDING_SECONDS=15.0
CONVERSATION_TIMEOUT=30.0
VOICE_INTERRUPTION_ENABLED=true

# Speech Synthesis (TTS) & Audio Playback
TTS_ENABLED=false
TTS_STREAM_ENABLED=false
TTS_EXPRESSION=gentle
TTS_ENGINE=native
TTS_VOICE_PROFILE=friday-gentle
TTS_VOICE=Samantha
TTS_RATE=165
TTS_VOLUME=1.0
TTS_TIMEOUT=60
TTS_LANGUAGE=auto
TTS_REFERENCE_PATH=
TTS_STYLE_STRENGTH=1.0
TTS_MIN_SEGMENT_CHARS=25

# External Services
NEWS_API_KEY=
INDIAN_NEWS_API=
WEATHER_API_KEY=
MAP=
